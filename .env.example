# Copy to .env (local) or set in your Vercel project settings.
# Leaving ANTHROPIC_AUTH_TOKEN unset keeps the app in local-only privacy mode.
#
# AI review calls an Anthropic-compatible Messages API. These defaults target
# AgentRouter (https://agentrouter.org). For official Anthropic instead, set
# ANTHROPIC_BASE_URL=https://api.anthropic.com and use an Anthropic API key.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://agentrouter.org
# Vision-capable model to use for extraction. Must be one your gateway/plan
# offers (e.g. claude-opus-4-8; a smaller model like claude-3-5-haiku costs less).
ANTHROPIC_MODEL=claude-opus-4-8
# Local Express AI-review server port (used by `npm run dev:all` only).
PORT=3001
